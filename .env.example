# Copy to .env and replace with the absolute path to the host projects folder.
DEVMIND_PROJECTS_DIR=/absolute/path/to/projects
DEVMIND_ENV=development
OLLAMA_URL=http://host.docker.internal:11434

# API rate limits (requests per minute). Health and readiness endpoints are
# never rate limited.
DEVMIND_RATE_LIMIT_INGEST=30/minute
DEVMIND_RATE_LIMIT_SEARCH=60/minute
DEVMIND_RATE_LIMIT_EXPLAIN=60/minute
DEVMIND_RATE_LIMIT_CHAT=60/minute
DEVMIND_RATE_LIMIT_CONVERSATION=120/minute

# Conversation and retrieval limits
DEVMIND_MAX_CONVERSATION_MESSAGES=50
DEVMIND_MAX_CONTEXT_CHUNKS=5
DEVMIND_MAX_SEARCH_RESULTS=10

# Embedding batch size
EMBED_BATCH_SIZE=16
